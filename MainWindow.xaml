<Window x:Class="Ensemble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ensemble.Controls"
        Title="Ensemble - Halo Wars Map Editor"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <DockPanel>

        <!-- MENU -->
        <Menu DockPanel.Dock="Top"
              Background="#2D2D30"
              Foreground="White">

            <MenuItem Header="_File">

                <MenuItem Header="_Open ERA..."
              Click="OpenEra_Click"/>

                <Separator/>

                <MenuItem x:Name="SaveMenuItem"
              Header="_Save"
              InputGestureText="Ctrl+S"
              Click="Save_Click"
              IsEnabled="False"/>

                <MenuItem x:Name="SaveAsMenuItem"
                          Header="Save _As..."
                          InputGestureText="Ctrl+Shift+S"
                          Click="SaveAs_Click"
                          IsEnabled="False"/>

                <Separator/>

                <MenuItem x:Name="ExportScenarioXmbMenuItem"
                          Header="Export Modified SCN XMB..."
                          Click="ExportScenarioXmb_Click"
                          IsEnabled="False"/>

                <Separator/>

                <MenuItem x:Name="ExtractAllMenuItem"
                          Header="Extract All"
                          Click="ExtractAll_Click"
                          IsEnabled="False"/>

                <Separator/>

                <MenuItem Header="E_xit"
                          Click="Exit_Click"/>

            </MenuItem>

            <MenuItem Header="_Edit">

                <MenuItem x:Name="UndoMenuItem"
              Header="_Undo"
              InputGestureText="Ctrl+Z"
              Click="Undo_Click"
              IsEnabled="False"/>

                <MenuItem x:Name="RedoMenuItem"
              Header="_Redo"
              InputGestureText="Ctrl+Y"
              Click="Redo_Click"
              IsEnabled="False"/>

                <Separator/>

                <MenuItem x:Name="AddObjectMenuItem"
          Header="_Add Object..."
          InputGestureText="Insert"
          Click="AddObject_Click"
          IsEnabled="False"/>

                <MenuItem x:Name="DuplicateObjectMenuItem"
          Header="_Duplicate Object"
          InputGestureText="Ctrl+D"
          Click="DuplicateObject_Click"
          IsEnabled="False"/>

                <MenuItem x:Name="DeleteObjectMenuItem"
          Header="_Delete Object"
          InputGestureText="Delete"
          Click="DeleteObject_Click"
          IsEnabled="False"/>

            </MenuItem>

            <MenuItem Header="_View"/>
            <MenuItem Header="_Map"/>
            <MenuItem Header="_Terrain"/>

            <MenuItem Header="_Tools">

                <MenuItem Header="Patch Halo Wars EXE..."
              Click="PatchHaloWarsExe_Click"/>

            </MenuItem>

            <MenuItem Header="_Help"/>

        </Menu>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#2D2D30"
                   Foreground="White">

            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"/>
            </StatusBarItem>

        </StatusBar>

        <!-- MAIN AREA -->
        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="330"/>

            </Grid.ColumnDefinitions>

            <!-- LEFT: ARCHIVE -->
            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,1,0">

                <DockPanel>

                    <Border DockPanel.Dock="Top"
                            Background="#333337"
                            Padding="10">

                        <TextBlock Text="ERA CONTENTS"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="13"/>

                    </Border>

                    <TreeView x:Name="ArchiveTree"
                              Background="#252526"
                              Foreground="White"
                              BorderThickness="0"
                              Padding="5"/>

                </DockPanel>

            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#3F3F46"/>

            <!-- CENTRE: VIEWPORT -->
            <Border Grid.Column="2"
                    Background="#1E1E1E">

                <Grid>

                    <StackPanel x:Name="WelcomePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="ENSEMBLE"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Halo Wars Map Editor"
                                   Foreground="#AAAAAA"
                                   FontSize="18"
                                   Margin="0,5,0,30"
                                   HorizontalAlignment="Center"/>

                        <Button Content="Open Halo Wars ERA"
                                Width="200"
                                Height="42"
                                Click="OpenEra_Click"/>

                    </StackPanel>

                    <TextBox x:Name="XmbPreviewText"
                             Visibility="Collapsed"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="#1E1E1E"
                             Foreground="#DCDCDC"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="13"
                             Padding="12"/>

                    <controls:MapCanvas x:Name="ScenarioMapCanvas"
                    Visibility="Collapsed"/>

                </Grid>

            </Border>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#3F3F46"/>

            <!-- RIGHT: ERA INFO -->
            <Border Grid.Column="4"
        Background="#252526"
        BorderBrush="#3F3F46"
        BorderThickness="1,0,0,0">

                <DockPanel>

                    <Border DockPanel.Dock="Top"
                Background="#333337"
                Padding="10">

                        <TextBlock x:Name="RightPanelTitle"
                       Text="ARCHIVE INFORMATION"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="13"/>

                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <Grid Margin="12">

                            <!-- ======================================== -->
                            <!-- ARCHIVE INFO                             -->
                            <!-- ======================================== -->

                            <StackPanel x:Name="ArchiveInfoPanel">

                                <TextBlock Text="File"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="FileNameText"
                               Text="-"
                               Foreground="White"
                               Margin="0,2,0,12"
                               TextWrapping="Wrap"/>

                                <TextBlock Text="Path"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="FilePathText"
                               Text="-"
                               Foreground="White"
                               Margin="0,2,0,12"
                               TextWrapping="Wrap"/>

                                <TextBlock Text="File Size"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="FileSizeText"
                               Text="-"
                               Foreground="White"
                               Margin="0,2,0,12"/>

                                <Separator Margin="0,5,0,10"/>

                                <TextBlock Text="First 64 Bytes"
                               Foreground="#AAAAAA"/>

                                <TextBox x:Name="HeaderHexText"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Background="#1E1E1E"
                             Foreground="#DCDCDC"
                             BorderBrush="#3F3F46"
                             FontFamily="Consolas"
                             Margin="0,4,0,12"
                             Padding="6"
                             MinHeight="90"/>

                                <TextBlock Text="ASCII"
                               Foreground="#AAAAAA"/>

                                <TextBox x:Name="HeaderAsciiText"
                             IsReadOnly="True"
                             Background="#1E1E1E"
                             Foreground="#DCDCDC"
                             BorderBrush="#3F3F46"
                             FontFamily="Consolas"
                             Margin="0,4,0,0"
                             Padding="6"/>

                            </StackPanel>

                            <!-- ======================================== -->
                            <!-- MAP SELECTION                            -->
                            <!-- ======================================== -->

                            <StackPanel x:Name="SelectionInfoPanel"
                            Visibility="Collapsed">

                                <TextBlock Text="Name"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedNameText"
                               Text="-"
                               Foreground="White"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,2,0,12"/>

                                <TextBlock Text="Type"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedTypeText"
                               Text="-"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,2,0,12"/>

                                <TextBlock Text="ID"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedIdText"
                               Text="-"
                               Foreground="White"
                               Margin="0,2,0,12"/>

                                <Separator Margin="0,2,0,10"/>

                                <TextBlock Text="Position"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedPositionText"
                               Text="-"
                               Foreground="White"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Margin="0,2,0,12"/>

                                <Separator Margin="0,2,0,10"/>

                                <TextBlock Text="Edit Position"
                                           Foreground="#AAAAAA"
                                           Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- X -->

                                    <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="X"
               Foreground="#AAAAAA"
               VerticalAlignment="Center"/>

                                    <TextBox x:Name="PositionXTextBox"
             Grid.Row="0"
             Grid.Column="1"
             Height="25"
             Margin="0,2"
             Padding="4,2"
             Background="#1E1E1E"
             Foreground="White"
             BorderBrush="#555555"
             FontFamily="Consolas"
             KeyDown="PositionTextBox_KeyDown"/>

                                    <!-- Y -->

                                    <TextBlock Grid.Row="1"
               Grid.Column="0"
               Text="Y"
               Foreground="#AAAAAA"
               VerticalAlignment="Center"/>

                                    <TextBox x:Name="PositionYTextBox"
             Grid.Row="1"
             Grid.Column="1"
             Height="25"
             Margin="0,2"
             Padding="4,2"
             Background="#1E1E1E"
             Foreground="White"
             BorderBrush="#555555"
             FontFamily="Consolas"
             KeyDown="PositionTextBox_KeyDown"/>

                                    <!-- Z -->

                                    <TextBlock Grid.Row="2"
               Grid.Column="0"
               Text="Z"
               Foreground="#AAAAAA"
               VerticalAlignment="Center"/>

                                    <TextBox x:Name="PositionZTextBox"
             Grid.Row="2"
             Grid.Column="1"
             Height="25"
             Margin="0,2"
             Padding="4,2"
             Background="#1E1E1E"
             Foreground="White"
             BorderBrush="#555555"
             FontFamily="Consolas"
             KeyDown="PositionTextBox_KeyDown"/>

                                </Grid>

                                <Button x:Name="ApplyPositionButton"
        Content="Apply Position"
        Height="30"
        Margin="0,0,0,12"
        Click="ApplyPosition_Click"/>

                                <TextBlock x:Name="PositionEditHintText"
           Text="Enter applies the position."
           Foreground="#777777"
           FontSize="10"
           Margin="0,0,0,12"/>

                                <TextBlock Text="Forward"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedForwardText"
                               Text="-"
                               Foreground="White"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Margin="0,2,0,12"/>

                                <TextBlock Text="Right"
           Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedRightText"
           Text="-"
           Foreground="White"
           FontFamily="Consolas"
           TextWrapping="Wrap"
           Margin="0,2,0,12"/>

                                <TextBlock Text="Yaw"
           Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedYawText"
           Text="-"
           Foreground="White"
           FontFamily="Consolas"
           Margin="0,2,0,12"/>

                                <Separator Margin="0,2,0,10"/>

                                <TextBlock Text="Edit Rotation"
           Foreground="#AAAAAA"
           Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
               Text="Yaw"
               Foreground="#AAAAAA"
               VerticalAlignment="Center"/>

                                    <TextBox x:Name="YawTextBox"
             Grid.Column="1"
             Height="25"
             Padding="4,2"
             Background="#1E1E1E"
             Foreground="White"
             BorderBrush="#555555"
             FontFamily="Consolas"
             KeyDown="YawTextBox_KeyDown"/>

                                </Grid>

                                <Button x:Name="ApplyRotationButton"
        Content="Apply Rotation"
        Height="30"
        Margin="0,0,0,5"
        Click="ApplyRotation_Click"/>

                                <TextBlock x:Name="RotationEditHintText"
           Text="Enter applies rotation. 0° = +Z."
           Foreground="#777777"
           FontSize="10"
           Margin="0,0,0,12"/>

                                <Separator Margin="0,2,0,10"/>

                                <TextBlock Text="Details"
                               Foreground="#AAAAAA"/>

                                <TextBlock x:Name="SelectedDetailsText"
                               Text="-"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,2,0,20"/>

                                <StackPanel x:Name="SphereRadiusEditorPanel"
                                            Visibility="Collapsed">

                                    <Separator Margin="0,4,0,10"/>

                                    <TextBlock Text="Edit Radius"
                                               Foreground="#AAAAAA"
                                               Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Radius"
                                                   Foreground="#AAAAAA"
                                                   VerticalAlignment="Center"/>

                                        <TextBox x:Name="SphereRadiusTextBox"
                                                 Grid.Column="1"
                                                 Height="25"
                                                 Padding="4,2"
                                                 Background="#1E1E1E"
                                                 Foreground="White"
                                                 BorderBrush="#555555"
                                                 FontFamily="Consolas"
                                                 KeyDown="SphereRadiusTextBox_KeyDown"/>

                                    </Grid>

                                    <Button Content="Apply Radius"
                                            Height="30"
                                            Click="ApplySphereRadius_Click"/>

                                </StackPanel>

                                <StackPanel x:Name="ObjectPropertiesEditorPanel"
            Visibility="Collapsed">

                                    <Separator Margin="0,4,0,10"/>

                                    <TextBlock Text="Edit Object Properties"
               Foreground="#AAAAAA"
               Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Player"
                   Foreground="#AAAAAA"
                   VerticalAlignment="Center"/>

                                        <TextBox x:Name="ObjectPlayerTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Height="25"
                 Margin="0,2"
                 Padding="4,2"
                 Background="#1E1E1E"
                 Foreground="White"
                 BorderBrush="#555555"
                 FontFamily="Consolas"
                 KeyDown="ObjectPropertyTextBox_KeyDown"/>

                                        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Group"
                   Foreground="#AAAAAA"
                   VerticalAlignment="Center"/>

                                        <TextBox x:Name="ObjectGroupTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Height="25"
                 Margin="0,2"
                 Padding="4,2"
                 Background="#1E1E1E"
                 Foreground="White"
                 BorderBrush="#555555"
                 FontFamily="Consolas"
                 KeyDown="ObjectPropertyTextBox_KeyDown"/>

                                        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Visual Variation"
                   Foreground="#AAAAAA"
                   VerticalAlignment="Center"/>

                                        <TextBox x:Name="ObjectVisualVariationTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="25"
                 Margin="0,2"
                 Padding="4,2"
                 Background="#1E1E1E"
                 Foreground="White"
                 BorderBrush="#555555"
                 FontFamily="Consolas"
                 KeyDown="ObjectPropertyTextBox_KeyDown"/>

                                    </Grid>

                                    <Button Content="Apply Object Properties"
            Height="30"
            Click="ApplyObjectProperties_Click"/>

                                </StackPanel>

                                <StackPanel x:Name="ArchiveInfoButtonPanel"
                                            Margin="0,20,0,0">

                                    <Button Content="Show Archive Information"
                                        Height="30"
                                        Click="ShowArchiveInfo_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </ScrollViewer>

                </DockPanel>

            </Border>

        </Grid>

    </DockPanel>

</Window>
