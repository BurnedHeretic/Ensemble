<Window x:Class="Ensemble.AddObjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Scenario Object"
        Width="620"
        Height="620"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock Text="ADD SCENARIO OBJECT"
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBlock Text="Choose an existing object type to use as a template."
                       Foreground="#AAAAAA"
                       Margin="0,3,0,0"/>

        </StackPanel>

        <!-- SEARCH -->

        <Grid Grid.Row="1"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Search"
                       Foreground="#BBBBBB"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Height="28"
                     Padding="5,3"
                     Background="#252526"
                     Foreground="White"
                     BorderBrush="#555555"
                     TextChanged="SearchTextBox_TextChanged"/>

        </Grid>

        <!-- TEMPLATE LIST -->

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                Margin="0,0,0,10">

            <ListBox x:Name="TemplateListBox"
                     Background="#252526"
                     Foreground="White"
                     BorderThickness="0"
                     SelectionChanged="TemplateListBox_SelectionChanged"
                     MouseDoubleClick="TemplateListBox_MouseDoubleClick">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="6">

                            <TextBlock Text="{Binding Type}"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding Description}"
                                       Foreground="#999999"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

        <!-- TEMPLATE DETAILS -->

        <Border Grid.Row="3"
                Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Category"
                           Foreground="#888888"/>

                <TextBlock x:Name="CategoryText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="-"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Template ID"
                           Foreground="#888888"/>

                <TextBlock x:Name="TemplateIdText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="-"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Editor Name"
                           Foreground="#888888"/>

                <TextBlock x:Name="EditorNameText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="-"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Player"
                           Foreground="#888888"/>

                <TextBlock x:Name="PlayerText"
                           Grid.Row="3"
                           Grid.Column="1"
                           Text="-"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Flags"
                           Foreground="#888888"/>

                <TextBlock x:Name="FlagsText"
                           Grid.Row="4"
                           Grid.Column="1"
                           Text="-"
                           TextWrapping="Wrap"/>

            </Grid>

        </Border>

        <!-- BUTTONS -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="AddButton"
                    Content="Add Object"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="AddButton_Click"/>

            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    IsCancel="True"/>

        </StackPanel>

    </Grid>

</Window>