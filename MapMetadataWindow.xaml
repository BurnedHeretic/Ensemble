<Window x:Class="Ensemble.MapMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Metadata"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">

            <TextBlock Text="CUSTOM MAP METADATA"
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBlock Text="Controls how the map is presented inside Halo Wars."
                       Foreground="#AAAAAA"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <Grid Grid.Row="1"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Internal ERA"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="InternalEraText"
                       Grid.Column="1"
                       Foreground="#DDDDDD"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"/>

        </Grid>


        <Grid Grid.Row="2"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Display Name"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="DisplayNameTextBox"
                     Grid.Column="1"
                     Height="30"
                     MaxLength="96"
                     Padding="6,4"
                     Background="#252526"
                     Foreground="White"
                     BorderBrush="#555555"/>

        </Grid>


        <Grid Grid.Row="3"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Description"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Top"
                       Margin="0,5,0,0"/>

            <TextBox x:Name="DescriptionTextBox"
                     Grid.Column="1"
                     MaxLength="512"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="6"
                     Background="#252526"
                     Foreground="White"
                     BorderBrush="#555555"/>

        </Grid>


        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Save"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="SaveButton_Click"/>

            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    IsCancel="True"/>

        </StackPanel>

    </Grid>
</Window>