<Window x:Class="Ensemble.MapMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Metadata"
        Width="590"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HwWindowGradientBrush}"
        Foreground="{StaticResource HwTextBrush}">

    <Border Margin="14"
            Padding="18"
            Background="{StaticResource HwPanelBrush}"
            BorderBrush="{StaticResource HwLineBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,18">
                <TextBlock Text="CUSTOM MAP METADATA"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{StaticResource HwAccentBrightBrush}"/>

                <TextBlock Text="Controls how the map is presented and how many player slots Halo Wars exposes."
                           Foreground="{StaticResource HwMutedTextBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Internal ERA"
                           Foreground="{StaticResource HwMutedTextBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="InternalEraText"
                           Grid.Column="1"
                           Foreground="{StaticResource HwAccentBrightBrush}"
                           TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Display Name"
                           Foreground="{StaticResource HwMutedTextBrush}"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="DisplayNameTextBox"
                         Grid.Column="1"
                         Height="31"
                         MaxLength="96"
                         Padding="7,4"/>
            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Player Count"
                           Foreground="{StaticResource HwMutedTextBrush}"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="PlayerCountComboBox"
                          Grid.Column="1"
                          Height="31"
                          SelectedIndex="0">
                    <ComboBoxItem Content="2 Players" Tag="2"/>
                    <ComboBoxItem Content="4 Players" Tag="4"/>
                    <ComboBoxItem Content="6 Players" Tag="6"/>
                </ComboBox>

                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource HwMutedTextBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Text="Assign starting bases from Map → Player Starts."/>
            </Grid>

            <Grid Grid.Row="4"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Description"
                           Foreground="{StaticResource HwMutedTextBrush}"
                           VerticalAlignment="Top"
                           Margin="0,5,0,0"/>

                <TextBox x:Name="DescriptionTextBox"
                         Grid.Column="1"
                         MaxLength="512"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="7"/>
            </Grid>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="SAVE"
                        Width="96"
                        Height="34"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="SaveButton_Click"/>

                <Button Content="CANCEL"
                        Width="96"
                        Height="34"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
