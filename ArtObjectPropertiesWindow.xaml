<Window x:Class="Ensemble.ArtObjectPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENSEMBLE // SC2 ART OBJECT"
        Width="520"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource HwBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HwAccentBrush}"/>

        <Border Grid.Row="1"
                Background="{StaticResource HwPanelRaisedBrush}"
                Padding="14,12"
                BorderBrush="{StaticResource HwLineBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="SC2 ART OBJECT PROPERTIES"
                       Style="{StaticResource HwPanelHeaderTextStyle}"/>
        </Border>

        <Grid Grid.Row="2" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="{StaticResource HwMutedTextBrush}" Margin="0,5"/>
            <TextBlock x:Name="TypeText" Grid.Row="0" Grid.Column="1" Text="-" TextWrapping="Wrap" Margin="0,5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="ID" Foreground="{StaticResource HwMutedTextBrush}" Margin="0,5"/>
            <TextBlock x:Name="IdText" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Editor name" Foreground="{StaticResource HwMutedTextBrush}" Margin="0,7"/>
            <TextBox x:Name="EditorNameText" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,3"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Group" Foreground="{StaticResource HwMutedTextBrush}" Margin="0,7"/>
            <TextBox x:Name="GroupText" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,3"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Visual variation" Foreground="{StaticResource HwMutedTextBrush}" Margin="0,7"/>
            <TextBox x:Name="VariationText" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,3"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Flags" Foreground="{StaticResource HwMutedTextBrush}" Margin="0,9,0,0"/>
            <TextBox x:Name="FlagsText" Grid.Row="5" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource HwPanelRaisedBrush}"
                BorderBrush="{StaticResource HwLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="APPLY" Width="100" Click="Apply_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
